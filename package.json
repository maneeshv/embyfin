{
  "name": "embyfin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {"#src/*": "./src/*"},
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "db:migrate": "wrangler d1 migrations apply embyfin --local --config wrangler.local.jsonc",
    "test": "node --test test/*.test.js && python3 -B -m unittest discover -s processor -p 'test_*.py' && python3 -B -m unittest discover -s ops -p 'test_*.py'",
    "check": "tsc && node --check public/app.js && python3 -c \"import ast,pathlib; ast.parse(pathlib.Path('processor/main.py').read_text())\"",
    "build": "wrangler deploy --dry-run --containers-rollout=none --outdir dist",
    "build:processor": "docker build --platform linux/amd64 -f processor/Dockerfile -t embyfin-processor .",
    "deploy": "node ops/deploy-config.mjs --deploy",
    "config": "node ops/deploy-config.mjs",
    "backup:context": "node ops/private-context.mjs context",
    "check:public": "python3 ops/check-public.py"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.2.0",
    "aws4fetch": "^1.0.20",
    "fast-xml-parser": "^5.3.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.147.0"
  }
}
