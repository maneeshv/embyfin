{
  "name": "embyfin-local",
  "main": "src/local.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "embyfin", "database_id": "local", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "POSTERS", "bucket_name": "embyfin-posters"}, {"binding": "BACKUPS", "bucket_name": "embyfin-backups"}],
  "vars": {"APP_ORIGIN": "http://localhost:8787", "OWNER_EMAIL": "owner@localhost", "SOURCE_BUCKET": "local-fixtures", "SOURCE_SCOPE": "", "MAINTENANCE": "false"}
}
