{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023"], "types": ["@cloudflare/workers-types"],
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
